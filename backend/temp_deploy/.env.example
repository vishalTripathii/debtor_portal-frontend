# Backend Environment Configuration
# Copy this file to .env and adjust values for your environment

# ============================================
# Django Settings
# ============================================

# Django secret key - CHANGE THIS IN PRODUCTION!
SECRET_KEY=your-secret-key-change-in-production

# Debug mode - set to False in production
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# MongoDB Settings
# ============================================

MONGODB_URI=mongodb://localhost:27017/
MONGODB_NAME=debtor_portal

# ============================================
# Admin Credentials (Initial Setup)
# ============================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================
# Email Settings (SMTP - for local development)
# ============================================

EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=your-email@example.com
COLLECTIONS_TEAM_EMAIL=collections@example.com

# ============================================
# CORS Settings
# ============================================

# Frontend URLs (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# Tesseract OCR Path (optional)
# ============================================

# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
# Leave empty to use system defaults
TESSERACT_PATH=

# ============================================
# AWS SERVERLESS CONFIGURATION
# (Only needed for AWS deployment)
# ============================================

# AWS Region
AWS_REGION=ap-southeast-1

# S3 Storage - set to True for serverless deployment
USE_S3_STORAGE=False
S3_BUCKET_NAME=debtor-portal-media-dev
S3_REGION=ap-southeast-1

# SQS for PDF Processing - set to True for serverless deployment
USE_SQS_FOR_PDF=False
PDF_QUEUE_URL=

# AWS SES Email - set to True to use SES instead of SMTP
USE_SES_EMAIL=False
SES_SENDER_EMAIL=noreply@yourdomain.com

# ============================================
# AWS CREDENTIALS (Local Development Only)
# ============================================

# For local development with AWS services:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Note: In Lambda, credentials are provided via IAM roles automatically

# ============================================
# AWS ACCOUNT INFORMATION (Reference Only)
# ============================================

# AWS Account ID: 490364002552
# AWS Console URL: https://490364002552.signin.aws.amazon.com/console
# IAM User: Deployement-user-PowerAmc
# Region: ap-southeast-1 (Singapore)

# ============================================
# PRODUCTION AWS PARAMETER STORE
# ============================================

# For production deployment, sensitive values are stored in
# AWS Systems Manager Parameter Store:
#
# /debtor-portal/prod/mongodb-uri
# /debtor-portal/prod/django-secret-key
# /debtor-portal/prod/ses-sender-email
#
# The serverless.yml file references these automatically
