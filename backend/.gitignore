# ============================================
# Backend .gitignore
# ============================================

# Environment files (NEVER commit these!)
.env
.env.local
.env.production
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
env/
venv/
.venv/
ENV/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Django
*.log
local_settings.py
db.sqlite3
*.sqlite3
*.db

# Static files
staticfiles/
static/

# Media files (user uploads)
media/uploads/*
media/payment_receipts/*
media/pdf_staging/*
media/debtor_images/*
!media/.gitkeep

# Serverless Framework
.serverless/
node_modules/
package-lock.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets
*.pem
*.key
secrets.json
