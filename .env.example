# Frontend Environment Configuration
# Copy this file to .env and adjust values for your environment

# ============================================
# API Configuration
# ============================================

# API Base URL - Change this for different environments
# Development (local): http://localhost:8000/api
# AWS Lambda/API Gateway: https://xxxxxxxxxx.execute-api.ap-southeast-1.amazonaws.com/dev/api
VITE_API_BASE_URL=http://localhost:8000/api

# Base URL for static assets (default: /)
# Used for S3/CloudFront deployments if assets are in a subdirectory
VITE_BASE_URL=/

# ============================================
# AWS Serverless Configuration (Production)
# ============================================

# AWS API Gateway URL (set after deploying backend)
# VITE_API_BASE_URL=https://your-api-id.execute-api.ap-southeast-1.amazonaws.com/prod/api
